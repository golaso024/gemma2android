<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices on Android 11 (API 30) and below.
   Auto-backup uploads app data to Google's cloud: the HF token must not leave the device.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Токен Hugging Face (SharedPreferences "hf_auth") не должен попадать в облако -->
    <exclude domain="sharedpref" path="hf_auth.xml" />
</full-backup-content>
