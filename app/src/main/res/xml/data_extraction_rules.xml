<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12+ (API 31+).
   Both cloud backups and device-to-device transfers must skip the HF token:
   it is validated against the Hugging Face account of the specific user.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Токен Hugging Face (SharedPreferences "hf_auth") не уезжает в Google-бэкап -->
        <exclude domain="sharedpref" path="hf_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- И при переносе на новое устройство вводится заново -->
        <exclude domain="sharedpref" path="hf_auth.xml" />
    </device-transfer>
</data-extraction-rules>
